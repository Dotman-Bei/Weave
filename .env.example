# --- Graph backend ---------------------------------------------------------
# "embedded" (default) needs nothing installed. "hydra" speaks Bolt/OpenCypher.
WEAVE_BACKEND=embedded
WEAVE_DB_PATH=data/weave.db

WEAVE_HYDRA_URI=neo4j://localhost:7687
WEAVE_HYDRA_TOKEN=local-development-token-32-bytes
# Ingestion writes use causal consistency; benchmark reads that must observe
# the latest consolidation use strong.
WEAVE_HYDRA_CONSISTENCY=causal

# --- HydraDB retrieval sidecar ---------------------------------------------
# The real HydraDB: a managed context API, used as an optional episodic text
# index. Distinct from WEAVE_HYDRA_* above, which configures the Bolt backend.
# Off unless a key is set. Get one at https://app.hydradb.com
HYDRA_DB_API_KEY=
WEAVE_SIDECAR=auto
WEAVE_SIDECAR_DB=weave
WEAVE_SIDECAR_COLLECTION=default

# --- Extraction and answers ------------------------------------------------
# Without a key Weave uses its deterministic rule-based extractor and a
# grounded template answerer. Both paths run end to end.
ANTHROPIC_API_KEY=
WEAVE_LLM_PROVIDER=auto
WEAVE_LLM_MODEL=claude-opus-5

# --- Retrieval and abstention ----------------------------------------------
WEAVE_ABSTENTION_THRESHOLD=0.3
WEAVE_MAX_CONTEXT_TOKENS=6000
WEAVE_RESOLUTION_POLICY=recency
WEAVE_AUTO_CONSOLIDATE=true

# --- Procedural learning ---------------------------------------------------
WEAVE_EXPLORATION_RATE=0.15
WEAVE_MIN_OUTCOMES=3
